<Window x:Class="TransparentTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TransparentTaskbar Settings"
        Height="540" Width="480"
        MinHeight="440" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        Background="#181818"
        Foreground="#ECECEC"
        FontFamily="Segoe UI, Segoe UI Variable Display">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C8CE6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0066B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#ECECEC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#353535"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#222222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Solid Dark ComboBox Brushes -->
        <SolidColorBrush x:Key="ComboBoxNormalBackground" Color="#282828"/>
        <SolidColorBrush x:Key="ComboBoxNormalBorder" Color="#3E3E3E"/>
        <SolidColorBrush x:Key="ComboBoxHoverBackground" Color="#323232"/>

        <!-- ToggleButton Template for ComboBox Entry -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="border"
                    Background="{StaticResource ComboBoxNormalBackground}"
                    BorderBrush="{StaticResource ComboBoxNormalBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow"
                          Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="#AAAAAA"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="{StaticResource ComboBoxHoverBackground}"/>
                    <Setter TargetName="border" Property="BorderBrush" Value="#555555"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="Background" Value="{StaticResource ComboBoxHoverBackground}"/>
                    <Setter TargetName="border" Property="BorderBrush" Value="#0078D7"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#0078D7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#383838"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#0078D7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ComboBox Template (Guarantees Dark Entry & Popup) -->
        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True" Height="38">
                <ToggleButton x:Name="toggleButton"
                              Template="{StaticResource ComboBoxToggleButtonTemplate}"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press"/>

                <!-- The Selected Item / Entry -->
                <ContentPresenter x:Name="contentPresenter"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="14,0,32,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#F5F5F5"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <!-- Dropdown Popup -->
                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       PlacementTarget="{Binding ElementName=toggleButton}"
                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Bottom"
                       PopupAnimation="Slide">
                    <Border x:Name="dropDownBorder"
                            MinWidth="{Binding ActualWidth, ElementName=toggleButton}"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                            Background="#202020"
                            BorderBrush="#444444"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,4,0,0">
                        <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Margin="4"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource DarkComboBoxTemplate}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="IsTabStop" Value="True"/>
        </Style>

        <!-- Modern ScrollViewer ScrollBar Styling -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="#444444">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#ECECEC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="TransparentTaskbar" FontSize="20" FontWeight="Bold" Foreground="#00A4EF"/>
            <TextBlock Text="Taskbar appearance and transparency settings" FontSize="12" Foreground="#888888" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Main Scrollable Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel VerticalAlignment="Top">

                <!-- Card: Style Mode -->
                <Border Background="#222222" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#333333" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Taskbar Appearance Style" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock Text="Select the visual effect applied to your taskbar" FontSize="12" Foreground="#999999" Margin="0,0,0,10"/>
                        <ComboBox x:Name="StyleComboBox" SelectionChanged="OnSettingChanged">
                            <ComboBoxItem Content="Clear (100% Glass / Transparent)" IsSelected="True"/>
                            <ComboBoxItem Content="Acrylic Blur (Modern Fluent)"/>
                            <ComboBoxItem Content="Standard Blur"/>
                            <ComboBoxItem Content="Default (Windows Native)"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Card: Opacity Slider -->
                <Border Background="#222222" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#333333" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Taskbar Opacity" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="OpacityValueText" Text="0%" FontWeight="Bold" FontSize="14" Foreground="#00A4EF" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="0% = 100% transparent wallpaper, 100% = solid" FontSize="12" Foreground="#999999" Margin="0,0,0,12"/>
                        <Slider x:Name="OpacitySlider"
                                Minimum="0" Maximum="100" Value="0"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="OnOpacitySliderValueChanged"/>
                    </StackPanel>
                </Border>

                <!-- Card: Top Border Removal -->
                <Border Background="#222222" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#333333" BorderThickness="1">
                    <StackPanel>
                        <CheckBox x:Name="RemoveTopBorderCheckBox"
                                  Content="Remove Taskbar Top Border"
                                  FontWeight="SemiBold"
                                  Checked="OnOptionToggleChanged"
                                  Unchecked="OnOptionToggleChanged"/>
                        <TextBlock Text="Hides the thin 1-pixel horizontal accent line across the top edge of the taskbar"
                                   FontSize="12" Foreground="#999999" Margin="24,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Card: Preserve Solid Icons -->
                <Border Background="#222222" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#333333" BorderThickness="1">
                    <StackPanel>
                        <CheckBox x:Name="PreserveSolidIconsCheckBox"
                                  Content="Keep Icons 100% Solid &amp; Vibrant"
                                  FontWeight="SemiBold"
                                  Checked="OnOptionToggleChanged"
                                  Unchecked="OnOptionToggleChanged"/>
                        <TextBlock Text="Guarantees icons and system tools stay 100% solid, crisp, and vibrant at any transparency level"
                                   FontSize="12" Foreground="#999999" Margin="24,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Card: Windows Startup -->
                <Border Background="#222222" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#333333" BorderThickness="1">
                    <StackPanel>
                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Content="Launch on Windows Startup (Priority 1)"
                                  FontWeight="SemiBold"
                                  Checked="OnStartupToggleChanged"
                                  Unchecked="OnStartupToggleChanged"/>
                        <TextBlock Text="Applies transparency instantly as soon as Windows and taskbar load (0s startup delay)"
                                   FontSize="12" Foreground="#999999" Margin="24,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card: Information & Credits -->
                <Border Background="#1D1D1D" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#2C2C2C" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="About" FontWeight="SemiBold" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                        <TextBlock Text="Developer: Rohit Singh + Gemini" FontSize="11" Foreground="#777777"/>
                        <TextBlock Text="Publisher: Rohit Singh Personal" FontSize="11" Foreground="#777777"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Fixed Footer Action Buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="StatusMessageText"
                       Text=""
                       FontSize="11"
                       Foreground="#AAAAAA"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       MaxWidth="230"
                       TextTrimming="CharacterEllipsis"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Width="90" Margin="0,0,10,0" Style="{StaticResource ModernButtonStyle}" Click="OnSaveClicked"/>
                <Button Content="Close" Width="80" Style="{StaticResource SecondaryButtonStyle}" Click="OnCloseClicked"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
