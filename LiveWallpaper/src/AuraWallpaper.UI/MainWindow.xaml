<Window x:Class="AuraWallpaper.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aura Live Wallpaper"
        Height="780" Width="1160"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Title Bar / Top Header -->
            <RowDefinition Height="56"/>
            <!-- Main Content Grid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/assets/app.png" Width="30" Height="30" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="AURA" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text=" LIVE WALLPAPER" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Quick Controls & Theme Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Theme Toggle Switch -->
                    <Button x:Name="ThemeToggleButton" Click="ThemeToggleButton_Click"
                            Width="88" Height="28" Margin="0,0,12,0"
                            Background="{DynamicResource ButtonBackground}"
                            Foreground="{DynamicResource TextPrimary}"
                            BorderBrush="{DynamicResource ButtonBorder}"
                            FontSize="11" Cursor="Hand" ToolTip="Toggle Light / Dark Mode">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="ThemeToggleIcon" Text="☀️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ThemeToggleText" Text="Light" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Volume slider -->
                    <TextBlock Text="Volume:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                    <Slider x:Name="GlobalVolumeSlider" Width="100" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center" Margin="0,0,12,0" ValueChanged="GlobalVolumeSlider_ValueChanged"/>

                    <Button x:Name="GlobalMuteButton" Content="Mute" Width="64" Height="28" Click="GlobalMuteButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ButtonBorder}" FontSize="11" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button x:Name="GlobalPlayPauseButton" Content="Pause All" Width="80" Height="28" Click="GlobalPlayPauseButton_Click" Background="{DynamicResource AccentBlue}" Foreground="White" BorderThickness="0" FontSize="11" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="Random" Width="70" Height="28" Click="RandomWallpaperButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ButtonBorder}" FontSize="11" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Navigation Sidebar + View Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0" Padding="12,16">
                <StackPanel>
                    <RadioButton x:Name="NavLibrary" Content="Wallpaper Library" IsChecked="True" Checked="Nav_Checked" Height="40" Margin="0,0,0,4"/>
                    <RadioButton x:Name="NavActive" Content="Active Wallpapers" Checked="Nav_Checked" Height="40" Margin="0,0,0,4"/>
                    <RadioButton x:Name="NavPlaylists" Content="Playlists &amp; Rotation" Checked="Nav_Checked" Height="40" Margin="0,0,0,4"/>
                    <RadioButton x:Name="NavScreensaver" Content="Screensaver" Checked="Nav_Checked" Height="40" Margin="0,0,0,4"/>
                    <RadioButton x:Name="NavCreator" Content="Wallpaper Creator" Checked="Nav_Checked" Height="40" Margin="0,0,0,4"/>
                    <RadioButton x:Name="NavPerformance" Content="Performance" Checked="Nav_Checked" Height="40" Margin="0,0,0,4"/>
                    <RadioButton x:Name="NavSettings" Content="Settings" Checked="Nav_Checked" Height="40" Margin="0,0,0,4"/>
                    <Separator Margin="0,8,0,8" Background="{DynamicResource CardBorder}"/>
                    <RadioButton x:Name="NavAbout" Content="About" Checked="Nav_Checked" Height="40" Margin="0,0,0,4"/>
                </StackPanel>
            </Border>

            <!-- Content Area Host -->
            <ContentControl Grid.Column="1" x:Name="MainContentHost"/>
        </Grid>
    </Grid>
</Window>
