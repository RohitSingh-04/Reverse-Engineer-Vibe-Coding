<UserControl x:Class="AuraWallpaper.UI.Views.ScreensaverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuraWallpaper.UI.Controls"
             Loaded="UserControl_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Windows Screensaver Integration" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Run live wallpapers as your official Windows screensaver across all connected displays." Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ScreensaverScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <!-- Source Card -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Screensaver Source" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                            <RadioButton x:Name="SourceActiveWallpaper" Content="Mirror Current Desktop Live Wallpaper" IsChecked="True" Checked="Source_Checked" Margin="0,0,0,10"/>
                            <RadioButton x:Name="SourceSpecificWallpaper" Content="Select a Specific Wallpaper" Checked="Source_Checked" Margin="0,0,0,10"/>

                            <!-- Specific wallpaper dropdown -->
                            <ComboBox x:Name="SpecificWallpaperCombo" Height="34" Margin="24,0,0,10" Visibility="Collapsed" DisplayMemberPath="Title" SelectionChanged="SpecificWallpaperCombo_SelectionChanged"/>

                            <RadioButton x:Name="SourcePlaylist" Content="Cycle Through an Aura Playlist" Checked="Source_Checked" Margin="0,0,0,10"/>
                            <ComboBox x:Name="PlaylistCombo" Height="34" Margin="24,0,0,0" Visibility="Collapsed" DisplayMemberPath="Name" SelectionChanged="PlaylistCombo_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Windows Screen Saver System Integration Card -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Windows System Integration" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <TextBlock Text="Windows uses .scr files located in System32 or installed via right-click to run native screensavers." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Test Screensaver Now" Width="170" Height="36" Click="TestScreensaver_Click"
                                        Background="{DynamicResource AccentBlue}" Foreground="White" BorderThickness="0" Margin="0,0,12,0" Cursor="Hand"/>
                                <Button Content="Open Windows Screensaver Settings" Width="240" Height="36" Click="OpenWindowsSettings_Click"
                                        Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ButtonBorder}" Margin="0,0,12,0" Cursor="Hand"/>
                                <Button Content="Install Screensaver (.scr)" Width="170" Height="36" Click="InstallScr_Click"
                                        Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextSecondary}" BorderBrush="{DynamicResource ButtonBorder}" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ChatGPT-Style Floating Scroll Navigator -->
            <controls:ScrollNavigator TargetScrollViewer="{Binding ElementName=ScreensaverScrollViewer}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,16,16"/>
        </Grid>
    </Grid>
</UserControl>
