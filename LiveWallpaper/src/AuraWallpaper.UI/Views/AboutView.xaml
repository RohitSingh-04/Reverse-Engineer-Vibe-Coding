<UserControl x:Class="AuraWallpaper.UI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuraWallpaper.UI.Controls">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/assets/app.png" Width="52" Height="52" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Aura Live Wallpaper" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <Border Background="{DynamicResource NavActiveBackground}" BorderBrush="{DynamicResource AccentBlue}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.0 Release" Foreground="{DynamicResource AccentBlue}" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Production-grade desktop live wallpaper &amp; screensaver platform for Windows." Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="AboutScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                    <!-- Developer & Organization Profile Card -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Developer &amp; Organization" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Developer:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Rohit Singh" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Organization:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Rohit Singh Personal" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center"/>
                            </Grid>

                            <Separator Background="{DynamicResource CardBorder}" Margin="0,0,0,16"/>

                            <!-- Social & Professional Links -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="GitHub:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="RohitSingh-04" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="View GitHub ↗" Width="130" Height="30" Click="GitHubButton_Click"
                                        Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ButtonBorder}" Cursor="Hand"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="LinkedIn:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="linkedin.com/in/rohiyaa" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="View LinkedIn ↗" Width="130" Height="30" Click="LinkedInButton_Click"
                                        Background="#0A66C2" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- AI Engineering & Architecture Card -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Engineering &amp; AI Technology" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <Border Background="#281A38" BorderBrush="#B388FF" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ AI Engineered" Foreground="#D1B3FF" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Built using Antigravity (Gemini 3.8 Flash)" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Engineered using Advanced Agentic Coding by Google DeepMind with full feature-for-feature functional parity with Lively Wallpaper." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Technology Stack:" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Grid.Column="1" Text="C# 12 / .NET 8.0 LTS (Native Windows Desktop)" Foreground="{DynamicResource TextPrimary}"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Video Playback Engine:" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Grid.Column="1" Text="Microsoft Edge WebView2 GPU Hardware Pipeline (DirectComposition)" Foreground="{DynamicResource TextPrimary}"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Audio Analysis:" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Grid.Column="1" Text="Windows WASAPI Loopback Capture + 64-band FFT Spectrum Analyzer" Foreground="{DynamicResource TextPrimary}"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Desktop Integration:" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Grid.Column="1" Text="Win32 Progman (0x052C) + WorkerW Window Reparenting" Foreground="{DynamicResource TextPrimary}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Automation Engine:" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Grid.Column="1" Text="wallctl CLI Utility + Local Named Pipe IPC" Foreground="{DynamicResource TextPrimary}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Software License & Copyright Card -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="License &amp; Copyright" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <TextBlock Text="Copyright © 2026 Rohit Singh. All rights reserved." Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBlock Text="Released under the MIT License. Free and open source for personal and commercial desktop customization." Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ChatGPT-Style Floating Scroll Navigator -->
            <controls:ScrollNavigator TargetScrollViewer="{Binding ElementName=AboutScrollViewer}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,16,16"/>
        </Grid>
    </Grid>
</UserControl>
