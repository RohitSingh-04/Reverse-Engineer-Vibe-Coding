<UserControl x:Class="AuraWallpaper.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuraWallpaper.UI.Controls"
             Loaded="UserControl_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Settings &amp; Configuration" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Application preferences, startup behavior, appearance theme, taskbar styling, and storage." Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <!-- General & Theme Section -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="General &amp; Startup" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>

                            <CheckBox x:Name="StartupCheckBox" Content="Launch Aura Live Wallpaper on Windows Startup" Margin="0,0,0,10" Click="Setting_Changed"/>
                            <CheckBox x:Name="StartMinimizedCheckBox" Content="Start Minimized in System Tray" Margin="0,0,0,10" Click="Setting_Changed"/>
                            <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Minimize to System Tray When Window is Closed" IsChecked="True" Margin="0,0,0,10" Click="Setting_Changed"/>
                            <CheckBox x:Name="HwAccelCheckBox" Content="Hardware Accelerated Video and Web Decoding" IsChecked="True" Margin="0,0,0,14" Click="Setting_Changed"/>

                            <Separator Background="{DynamicResource CardBorder}" Margin="0,0,0,14"/>

                            <!-- Theme Selector -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Application Theme:" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Switch between Dark and Light mode across all interface elements." Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                </StackPanel>
                                <ComboBox x:Name="AppThemeCombo" Grid.Column="1" Width="180" Height="34" SelectionChanged="AppThemeCombo_SelectionChanged">
                                    <ComboBoxItem Content="🌙 Dark Theme"/>
                                    <ComboBoxItem Content="☀️ Light Theme"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Taskbar Styling Section -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Windows Taskbar Appearance" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <TextBlock Text="Customize taskbar transparency, blur, and acrylic fluent blur seamlessly over the wallpaper." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Taskbar Theme Mode:" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                <ComboBox x:Name="TaskbarThemeCombo" Grid.Column="1" Width="210" Height="34" SelectionChanged="TaskbarThemeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Default Windows Theme"/>
                                    <ComboBoxItem Content="Clear (Transparent)"/>
                                    <ComboBoxItem Content="Blur Behind"/>
                                    <ComboBoxItem Content="Acrylic / Fluent Blur"/>
                                    <ComboBoxItem Content="Wallpaper Tinted"/>
                                </ComboBox>
                            </Grid>

                            <!-- Windows 11 & Transparency Notice -->
                            <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="💡 Windows 11 &amp; Transparency Effects Guide:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentBlue}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Requires 'Transparency effects' to be enabled in Windows Personalization. On Windows 11 (22H2+), Microsoft's new XAML taskbar layer may enforce its own background brush over DWM; running companion tools like TranslucentTB is fully supported alongside Aura."
                                               Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Button Content="Open Windows Transparency Settings ↗" HorizontalAlignment="Left" Padding="12,4" Height="28" Click="OpenWindowsColorSettings_Click"
                                            Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ButtonBorder}" FontSize="11" Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Storage & Library Location Section -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Library Storage &amp; Database" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <TextBlock Text="Current wallpaper storage directory:" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="LibraryPathTextBox" IsReadOnly="True" Height="32" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open Library Folder" Width="150" Height="32" Click="OpenFolderButton_Click"
                                        Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ButtonBorder}" Margin="0,0,10,0" Cursor="Hand"/>
                                <Button Content="Change Location" Width="130" Height="32" Click="ChangeFolderButton_Click"
                                        Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextSecondary}" BorderBrush="{DynamicResource ButtonBorder}" Margin="0,0,10,0" Cursor="Hand"/>
                                <Button Content="Open Logs Folder" Width="135" Height="32" Click="OpenLogsFolderButton_Click"
                                        Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextSecondary}" BorderBrush="{DynamicResource ButtonBorder}" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Backup & Reset Section -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Backup &amp; Reset" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Backup Database" Width="140" Height="32" Click="BackupButton_Click"
                                        Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ButtonBorder}" Margin="0,0,10,0" Cursor="Hand"/>
                                <Button Content="Restore Database" Width="140" Height="32" Click="RestoreButton_Click"
                                        Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ButtonBorder}" Margin="0,0,10,0" Cursor="Hand"/>
                                <Button Content="Reset All Settings" Width="140" Height="32" Click="ResetSettingsButton_Click"
                                        Background="#3D2020" Foreground="#FFA0A0" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ChatGPT-Style Floating Scroll Navigator -->
            <controls:ScrollNavigator TargetScrollViewer="{Binding ElementName=SettingsScrollViewer}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,16,16"/>
        </Grid>
    </Grid>
</UserControl>
