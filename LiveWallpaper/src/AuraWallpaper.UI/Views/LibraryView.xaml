<UserControl x:Class="AuraWallpaper.UI.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:AuraWallpaper.UI.Converters"
             xmlns:controls="clr-namespace:AuraWallpaper.UI.Controls"
             Loaded="UserControl_Loaded"
             AllowDrop="True"
             DragOver="LibraryView_DragOver"
             Drop="LibraryView_Drop">
    <UserControl.Resources>
        <converters:TypeToIconConverter x:Key="TypeToIconConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header & Action Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="Wallpaper Library" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Manage and apply interactive, video, and animated desktop wallpapers." Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ Import Wallpaper" Width="150" Height="36" Click="ImportButton_Click" Background="{DynamicResource AccentBlue}" Foreground="White" BorderThickness="0" FontWeight="Medium" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Search, Filter & Target Display Controls (Fully Responsive) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search box (Row 0, Left) -->
            <TextBox x:Name="SearchBox" Grid.Row="0" Grid.Column="0" Height="34" Width="260" MaxWidth="320" HorizontalAlignment="Left"
                     TextChanged="SearchBox_TextChanged" Text="" Tag="Search wallpapers..."/>

            <!-- Monitor Selector Dropdown (Row 0, Right) -->
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="Target Display:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" FontSize="12"/>
                <ComboBox x:Name="MonitorTargetCombo" Width="190" Height="34"/>
            </StackPanel>

            <!-- Filter chips in a responsive WrapPanel (Row 1) -->
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                <RadioButton x:Name="FilterAll" GroupName="FilterChips" Content="All" IsChecked="True" Checked="Filter_Checked" Margin="0,0,8,6"/>
                <RadioButton x:Name="FilterVideo" GroupName="FilterChips" Content="Videos" Checked="Filter_Checked" Margin="0,0,8,6"/>
                <RadioButton x:Name="FilterWeb" GroupName="FilterChips" Content="Web / Interactive" Checked="Filter_Checked" Margin="0,0,8,6"/>
                <RadioButton x:Name="FilterGif" GroupName="FilterChips" Content="GIFs" Checked="Filter_Checked" Margin="0,0,8,6"/>
                <RadioButton x:Name="FilterPictures" GroupName="FilterChips" Content="Pictures" Checked="Filter_Checked" Margin="0,0,8,6"/>
                <RadioButton x:Name="FilterApps" GroupName="FilterChips" Content="Applications" Checked="Filter_Checked" Margin="0,0,8,6"/>
                <RadioButton x:Name="FilterFavorites" GroupName="FilterChips" Content="★ Favorites" Checked="Filter_Checked" Margin="0,0,8,6"/>
            </WrapPanel>
        </Grid>

        <!-- Wallpaper Gallery -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="WallpapersScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="WallpapersItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="260" ItemHeight="265"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,16,16" CornerRadius="8" Padding="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                                <Setter Property="Background" Value="{DynamicResource CardHover}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Apply to Selected Monitor" Click="MenuApply_Click"/>
                                        <MenuItem Header="Apply (Span across all displays)" Click="MenuSpan_Click"/>
                                        <MenuItem Header="Apply (Duplicate on all displays)" Click="MenuDuplicate_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Customize Properties" Click="MenuCustomize_Click"/>
                                        <MenuItem Header="Toggle Favorite" Click="MenuFavorite_Click"/>
                                        <MenuItem Header="Export as Package (.aurapkg)" Click="MenuExport_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Delete from Library" Click="MenuDelete_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="130"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Thumbnail & Fallback Container -->
                                    <Border Grid.Row="0" CornerRadius="6" ClipToBounds="True">
                                        <Grid>
                                            <!-- Fallback Visual Card (shown if Thumbnail missing or loading) -->
                                            <Border>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#1A2234" Offset="0.0"/>
                                                        <GradientStop Color="#0D121B" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <!-- Category Icon Watermark -->
                                                    <TextBlock Text="{Binding Type, Converter={StaticResource TypeToIconConverter}}"
                                                               FontSize="36" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,14"/>
                                                    <!-- Fallback Title -->
                                                    <TextBlock Text="{Binding Title}" Foreground="#C5D1E0" FontWeight="SemiBold" FontSize="11"
                                                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom"
                                                               Margin="8,0,8,8" TextTrimming="CharacterEllipsis" MaxHeight="30"/>
                                                </Grid>
                                            </Border>

                                            <!-- Actual Thumbnail Image (renders over fallback if available) -->
                                            <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/>

                                            <!-- Category Tag Badge (Top Right) -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,2" CornerRadius="4" Background="#D9111624">
                                                <TextBlock Text="{Binding Type}" Foreground="#60CDFF" FontSize="9" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Metadata -->
                                    <StackPanel Grid.Row="1" Margin="2,8,2,6">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Author}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <Grid Grid.Row="2" Margin="0,4,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Apply Wallpaper Button with Play Icon -->
                                        <Button Grid.Column="0" Height="32" Click="ApplyButton_Click"
                                                Background="{DynamicResource AccentBlue}" Foreground="White" BorderThickness="0"
                                                Cursor="Hand" ToolTip="Set as Active Desktop Wallpaper">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,0">
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock Text="▶" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="Apply" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="btnBorder" Property="Background" Value="#1084D8"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="btnBorder" Property="Background" Value="#006CBE"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Customize Settings Icon Button -->
                                        <Button Grid.Column="1" Width="36" Height="32" Click="CustomizeButton_Click"
                                                Background="{DynamicResource ButtonBackground}" BorderThickness="0" Margin="8,0,0,0"
                                                Cursor="Hand" ToolTip="Customize Wallpaper Properties">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="cBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="6">
                                                                    <TextBlock Text="⚙" FontSize="16" Foreground="{DynamicResource AccentBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="cBorder" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                                                                        <Setter TargetName="cBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="cBorder" Property="Opacity" Value="0.8"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ChatGPT-Style Floating Scroll Navigator -->
            <controls:ScrollNavigator TargetScrollViewer="{Binding ElementName=WallpapersScrollViewer}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,16,16"/>
        </Grid>
    </Grid>
</UserControl>
