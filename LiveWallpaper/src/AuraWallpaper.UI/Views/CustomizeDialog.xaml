<Window x:Class="AuraWallpaper.UI.Views.CustomizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customize Wallpaper"
        Height="540" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock x:Name="WallpaperTitleText" Text="Wallpaper Customization" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Adjust dynamic properties and visual settings in real-time." Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PropertiesContainer" Margin="0,0,12,0"/>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Reset Defaults" HorizontalAlignment="Left" Width="120" Height="34" Click="ResetButton_Click"
                    Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextSecondary}" BorderBrush="{DynamicResource ButtonBorder}" Cursor="Hand"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Width="90" Height="34" Margin="0,0,8,0" Click="SaveButton_Click"
                        Background="{DynamicResource AccentBlue}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Cancel" Width="90" Height="34" Click="CancelButton_Click"
                        Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ButtonBorder}" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
