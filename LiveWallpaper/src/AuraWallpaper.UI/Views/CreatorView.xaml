<UserControl x:Class="AuraWallpaper.UI.Views.CreatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuraWallpaper.UI.Controls">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Wallpaper Creator &amp; SDK" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Create custom interactive wallpapers from templates, videos, or web projects and package them." Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="CreatorScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <!-- Project Generator Card -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="New Wallpaper Project" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>

                            <TextBlock Text="Wallpaper Title:" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ProjectTitleTextBox" Text="My Interactive Wallpaper" Height="34" Margin="0,0,0,12"/>

                            <TextBlock Text="Author:" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ProjectAuthorTextBox" Text="Developer" Height="34" Margin="0,0,0,12"/>

                            <TextBlock Text="Description:" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ProjectDescTextBox" Text="Real-time interactive wallpaper built for Aura Live Wallpaper." Height="34" Margin="0,0,0,16"/>

                            <TextBlock Text="Select Project Template:" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="TemplateCombo" Height="34" Margin="0,0,0,16">
                                <ComboBoxItem Content="Audio Visualizer Waveform (HTML5 Canvas + WASAPI Audio)" IsSelected="True"/>
                                <ComboBoxItem Content="Cyberpunk Digital Matrix Rain (Interactive WebGL/Canvas)"/>
                                <ComboBoxItem Content="Deep Space Nebula Particles (Interactive Three.js / Canvas)"/>
                                <ComboBoxItem Content="Minimal Aesthetic Clock &amp; Calendar"/>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Generate Project &amp; Add to Library" Width="260" Height="36" Click="GenerateProject_Click"
                                        Background="{DynamicResource AccentBlue}" Foreground="White" BorderThickness="0" FontWeight="Medium" Margin="0,0,12,0" Cursor="Hand"/>
                                <Button Content="Import Existing Folder" Width="180" Height="36" Click="ImportFolder_Click"
                                        Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ButtonBorder}" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Web URL Import Card -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Import Web URL / ShaderToy / Dashboard" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <TextBlock Text="Use any remote website, WebGL shader (Shadertoy), or live web dashboard as your desktop wallpaper." Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>

                            <TextBlock Text="Web Page URL:" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="WebUrlTextBox" Text="https://" Height="34" Margin="0,0,0,10"/>

                            <TextBlock Text="Title (Optional):" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="WebUrlTitleTextBox" Height="34" Margin="0,0,0,16"/>

                            <Button Content="Import Web Wallpaper" Width="180" Height="36" Click="ImportUrl_Click"
                                    Background="{DynamicResource AccentBlue}" Foreground="White" BorderThickness="0" FontWeight="Medium" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- SDK & Developer API Documentation Card -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Aura Developer SDK Reference" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <TextBlock Text="Interactive wallpapers have full access to real-time audio and dynamic customization properties:" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <TextBlock FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource AccentBlue}" TextWrapping="Wrap">
// Audio visualizer hook: (64 spectrum frequency bins)&#x0a;
window.auraAudioListener = function(spectrumArray) {&#x0a;
    // spectrumArray contains 64 normalized float values (0.0 to 1.0)&#x0a;
};&#x0a;&#x0a;
// Dynamic properties change listener:&#x0a;
window.auraPropertyListener = function(name, value) {&#x0a;
    console.log('Property changed:', name, value);&#x0a;
};&#x0a;&#x0a;
// Also fully supports Lively Wallpaper hooks:&#x0a;
// window.livelyAudioListener(spectrum)&#x0a;
// window.livelyPropertyListener(name, val)
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ChatGPT-Style Floating Scroll Navigator -->
            <controls:ScrollNavigator TargetScrollViewer="{Binding ElementName=CreatorScrollViewer}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,16,16"/>
        </Grid>
    </Grid>
</UserControl>
