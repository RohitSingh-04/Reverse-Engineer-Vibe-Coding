<UserControl x:Class="AuraWallpaper.UI.Views.PlaylistsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Playlists &amp; Automatic Rotation" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Create collections of wallpapers and automatically cycle them on a scheduled timer or shuffle." Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Content="+ New Playlist" Width="130" Height="36" Click="NewPlaylistButton_Click"
                    Background="{DynamicResource AccentBlue}" Foreground="White" BorderThickness="0" FontWeight="Medium" Cursor="Hand"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Playlists List -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Your Playlists" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimary}" Margin="4,0,0,8"/>
                    <ListBox Grid.Row="1" x:Name="PlaylistsListBox" SelectionChanged="PlaylistsListBox_SelectionChanged" Background="Transparent" BorderThickness="0" DisplayMemberPath="Name" Foreground="{DynamicResource TextPrimary}"/>
                </Grid>
            </Border>

            <!-- Playlist Details & Items Editor -->
            <Border Grid.Column="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid x:Name="PlaylistDetailsGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Playlist Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Vertical">
                            <TextBox x:Name="PlaylistNameTextBox" FontSize="18" FontWeight="SemiBold" Width="260" HorizontalAlignment="Left"/>
                            <TextBlock Text="Configure rotation duration, repeat, and shuffle options." Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ToggleActiveButton" Content="Start Playlist" Width="120" Height="32" Margin="0,0,8,0" Click="ToggleActiveButton_Click"
                                    Background="{DynamicResource AccentBlue}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="Delete" Width="80" Height="32" Click="DeletePlaylistButton_Click"
                                    Background="#3D2020" Foreground="#FFA0A0" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- Configuration Options -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Interval:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="IntervalCombo" Width="120" Height="32" SelectionChanged="IntervalCombo_SelectionChanged" Margin="0,0,20,0">
                            <ComboBoxItem Content="1 minute" Tag="60"/>
                            <ComboBoxItem Content="5 minutes" Tag="300"/>
                            <ComboBoxItem Content="15 minutes" Tag="900"/>
                            <ComboBoxItem Content="30 minutes" Tag="1800"/>
                            <ComboBoxItem Content="1 hour" Tag="3600"/>
                        </ComboBox>

                        <CheckBox x:Name="ShuffleCheckBox" Content="Shuffle" VerticalAlignment="Center" Margin="0,0,16,0" Click="ShuffleCheckBox_Click"/>
                        <CheckBox x:Name="RepeatCheckBox" Content="Loop Repeat" IsChecked="True" VerticalAlignment="Center" Click="RepeatCheckBox_Click"/>
                    </StackPanel>

                    <!-- Items in Playlist -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Wallpapers in this Playlist" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <Button Content="+ Add Wallpaper" HorizontalAlignment="Right" Width="120" Height="28" Click="AddWallpaperToPlaylist_Click"
                                    Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ButtonBorder}" Cursor="Hand"/>
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4">
                            <ListBox x:Name="PlaylistItemsListBox" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" FontSize="13"/>
                                            <Button Grid.Column="1" Content="Remove" Width="60" Height="24" Click="RemovePlaylistItem_Click"
                                                    Background="#3D2020" Foreground="#FFA0A0" BorderThickness="0" FontSize="10" Cursor="Hand"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
