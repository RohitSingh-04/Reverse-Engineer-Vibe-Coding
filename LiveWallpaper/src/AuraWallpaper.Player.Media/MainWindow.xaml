<Window x:Class="AuraWallpaper.Player.Media.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aura Media Player"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Black">
    <Grid Background="Black">
        <!-- Ambient Blurred Backdrop for Picture/GIF -->
        <Image x:Name="AmbientPicturePlayer"
               Stretch="UniformToFill"
               Visibility="Collapsed"
               Opacity="0.65">
            <Image.Effect>
                <BlurEffect Radius="60" KernelType="Gaussian"/>
            </Image.Effect>
        </Image>

        <!-- Video Player -->
        <MediaElement x:Name="MediaPlayer"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      ScrubbingEnabled="True"
                      Visibility="Collapsed" />

        <!-- Static Image / GIF Player -->
        <Image x:Name="PicturePlayer"
               Visibility="Collapsed" />
    </Grid>
</Window>
